{
  "name": "laxdb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/compact-data.mjs && vite build && node scripts/gen-sitemap.mjs",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json",
    "cms:build": "node scripts/build-functions.mjs",
    "cms:dev": "node scripts/cms-dev-server.mjs",
    "cms": "npm run cms:build && npm run cms:dev",
    "sitemap": "node scripts/gen-sitemap.mjs",
    "entity-index": "node scripts/gen-entity-index.mjs",
    "db:check": "node scripts/db-check.mjs",
    "db:schema": "node scripts/apply-schema.mjs",
    "db:load": "node scripts/load-supabase.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/blobs": "^11.1.9",
    "@resvg/resvg-wasm": "^2.6.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "netlify-cli": "^27.18.0",
    "pg": "^8.23.1",
    "satori": "^0.63.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
