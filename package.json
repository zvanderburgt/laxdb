{
  "name": "laxdb",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json",
    "cms:build": "node scripts/build-functions.mjs",
    "cms:dev": "node scripts/cms-dev-server.mjs",
    "cms": "npm run cms:build && npm run cms:dev"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@netlify/blobs": "^11.1.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "netlify-cli": "^27.18.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
